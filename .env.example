# Supabase (Backend - Database only, auth moved to Firebase)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-service-key

# Firebase Auth (NEW - replaces Supabase auth)
FIREBASE_CREDENTIALS={"type":"service_account","project_id":"...","private_key_id":"...","private_key":"...","client_email":"...","client_id":"...","auth_uri":"...","token_uri":"..."}
FIREBASE_PROJECT_ID=lifestoryagent-xxx

# Frontend (Vite)
VITE_API_URL=http://localhost:8000

# Firebase (NEW - frontend config)
VITE_FIREBASE_API_KEY=xxx
VITE_FIREBASE_AUTH_DOMAIN=lifestoryagent.uk
VITE_FIREBASE_PROJECT_ID=lifestoryagent-xxx
VITE_FIREBASE_APP_ID=xxx

# OpenAI
OPENAI_API_KEY=sk-proj-your-key
OPENAI_MODEL=gpt-4o-mini
TTS_MODEL=gpt-4o-mini-tts

# Sentry (error tracking)
SENTRY_DSN=

# LangFuse (LLM tracing)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com

# App
ENVIRONMENT=development
LOG_LEVEL=info
CORS_ORIGINS=http://localhost:5173,https://www.lifestoryagent.uk
MAX_META_STORY_SELECT=10

# Admin (for dashboard access)
ADMIN_EMAIL=your-email@example.com

# Evaluation (LLM-as-judge)
EVAL_ENABLED=false
EVAL_SAMPLE_RATE=0.1