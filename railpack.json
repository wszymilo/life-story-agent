{
  "$schema": "https://schema.railpack.com",
  "provider": "python",
  "buildAptPackages": ["git"],
  "steps": {
    "build": {
      "inputs": []
    }
  },
  "deploy": {
    "base": {
      "image": "ghcr.io/railwayapp/railpack-runtime:mise-2026.2.22"
    },
    "inputs": [
      {"local": true, "include": ["app", "supabase", "pyproject.toml", "railpack.json"]},
      {"local": true, "exclude": ["node_modules", ".git", ".venv", ".env"]}
    ],
    "startCommand": "cd app && uv sync && cd app && uv run uvicorn main:app --host 0.0.0.0 --port $PORT"
  }
}