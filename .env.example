# AWS Cognito (Auth)
VITE_COGNITO_REGION=eu-west-1
VITE_COGNITO_USER_POOL_ID=eu-west-1_xxxxx
VITE_COGNITO_CLIENT_ID=xxxxx

# API (Backend)
VITE_API_URL=https://d2pahmt9j4e9bl.cloudfront.net

# OpenAI
OPENAI_API_KEY=sk-proj-your-key
OPENAI_MODEL=gpt-4o-mini
TTS_MODEL=gpt-4o-mini-tts

# Sentry (error tracking)
# Get from: https://sentry.io -> Project -> Settings -> Client Keys
SENTRY_DSN=

# LangFuse (LLM tracing)
# Get from: https://cloud.langfuse.com -> Settings
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com

# App
ENVIRONMENT=development
LOG_LEVEL=info
CORS_ORIGINS=http://localhost:5173
MAX_META_STORY_SELECT=10

# Admin (for dashboard access)
ADMIN_EMAIL=your-email@example.com

# Evaluation (LLM-as-judge)
EVAL_ENABLED=false
EVAL_SAMPLE_RATE=0.1