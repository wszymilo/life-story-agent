# ── Backend (used by docker-compose and uvicorn) ────────────────────────────
# Set a strong value, e.g.:  openssl rand -hex 32
DB_PASSWORD=change-me                # PostgreSQL password (docker-compose)
# Inside Docker, compose overrides the host to `postgres` — this DSN is for
# direct uvicorn runs only (localhost). Both must share the same password.
DATABASE_URL=postgresql://app:change-me@localhost:5432/life_story_agent
AUDIO_STORAGE_PATH=/data/audio-recordings

# ── Auth (Firebase) ─────────────────────────────────────────────────────────
FIREBASE_CREDENTIALS={"type":"service_account","project_id":"...","private_key_id":"...","private_key":"...","client_email":"...","client_id":"...","auth_uri":"...","token_uri":"..."}
FIREBASE_PROJECT_ID=your-firebase-project

# ── OpenAI ──────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini
TTS_MODEL=gpt-4o-mini-tts

# ── Observability ───────────────────────────────────────────────────────────
SENTRY_DSN=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com

# ── Application ─────────────────────────────────────────────────────────────
# NOTE: docker-compose.prod.yml forces ENVIRONMENT=production and
# CORS_ORIGINS=https://www.lifestoryagent.uk for prod runs, so these values
# apply to local/direct uvicorn runs.
ENVIRONMENT=development
LOG_LEVEL=info
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,https://www.lifestoryagent.uk
MAX_META_STORY_SELECT=10
ADMIN_EMAIL=your-email@example.com
EVAL_ENABLED=false
EVAL_SAMPLE_RATE=0.1

# ── Frontend (Vite / Vercel — copy to .env.local) ──────────────────────────
VITE_FIREBASE_API_KEY=xxx
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-firebase-project
VITE_FIREBASE_APP_ID=xxx

# Used by vercel.json routes — points to the backend (local: localhost:8000,
# production: https://xapi.lifestoryagent.uk)
API_URL=http://localhost:8000
